[Unit]
Description=Pythontr for Starlette project
After=network.target

[Service]
User=husonet
Group=husonet
WorkingDirectory=/home/www/api.pythontr.com
ExecStart=/home/www/api/.venv/bin/gunicorn --workers 4 --worker-class uvicorn.workers.UvicornWorker --bind unix:/home/www/api/run/app.sock app.main:app

[Install]
WantedBy=multi-user.target